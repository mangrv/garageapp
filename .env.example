# GarageMeet runtime settings — copy to .env (never commit real values).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/garagemeet?schema=public
SESSION_SECRET=
NEXT_PUBLIC_BASE_URL=https://garagemeet.com

# Google sign-in (OAuth web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://garagemeet.com/api/auth/google/callback

# Media storage (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=
AWS_ACL=private
AWS_SIGNED_URL_EXPIRES=900

# AI assistant
GARAGEMEET_AI_PROVIDER=ollama
GARAGEMEET_AI_MODEL=
OLLAMA_OPENAI_BASE_URL=
OLLAMA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

GARAGE_REQUEST_LOGS=0
